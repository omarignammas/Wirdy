{
  "name": "wirdy",
  "version": "1.0.0",
  "description": "A bilingual, local-first Quran reading companion built with Expo and SQLite.",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify:sources": "node scripts/verify-data-sources.mjs",
    "verify": "npm run typecheck && npm run verify:sources"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@expo/vector-icons": "15.1.1",
    "expo": "57.0.12",
    "expo-audio": "57.0.3",
    "expo-asset": "57.0.10",
    "expo-crypto": "57.0.1",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.2",
    "expo-notifications": "57.0.10",
    "expo-secure-store": "57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.8.1",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
