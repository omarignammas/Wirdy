{
  "name": "wirdy",
  "version": "1.0.0",
  "description": "A bilingual, local-first Quran reading companion built with Expo and SQLite.",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify:sources": "node scripts/verify-data-sources.mjs",
    "verify": "npm run typecheck && npm run verify:sources"
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/lateef": "^0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.12",
    "expo-asset": "57.0.10",
    "expo-audio": "57.0.3",
    "expo-blur": "~57.0.2",
    "expo-crypto": "57.0.1",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-notifications": "57.0.10",
    "expo-secure-store": "57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
